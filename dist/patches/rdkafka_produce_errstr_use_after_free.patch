 /**
+ * @brief Set the error string of a produced message.
+ *
+ * The string is copied: \p errstr may point into the Produce result,
+ * which is freed before the delivery report is served.
+ */
+static void rd_kafka_msg_set_produce_errstr(rd_kafka_msg_t *rkm,
+                                            const char *errstr) {
+        if (rkm->rkm_u.producer.errstr)
+                rd_free(rkm->rkm_u.producer.errstr);
+        rkm->rkm_u.producer.errstr = errstr ? rd_strdup(errstr) : NULL;
+}
